generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  shortName   String?
  iban        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees         CompanyEmployee[]
  payrollRecords    PayrollRecord[]
  bankTransactions  BankTransaction[]
  uploadedFiles     UploadedFile[]
}

model Employee {
  id          String   @id @default(uuid())
  employeeId  String?
  name        String
  iban        String?
  taxClass    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies       CompanyEmployee[]
  payrollRecords  PayrollRecord[]
  reconciliations ReconciliationRecord[]
}

model CompanyEmployee {
  id         String   @id @default(uuid())
  company    Company  @relation(fields: [companyId], references: [id])
  companyId  String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  startDate  DateTime?
  endDate    DateTime?
  active     Boolean  @default(true)

  @@unique([companyId, employeeId])
}

model PayrollRecord {
  id                  String   @id @default(uuid())
  company             Company  @relation(fields: [companyId], references: [id])
  companyId           String
  employee            Employee @relation(fields: [employeeId], references: [id])
  employeeId          String
  salaryMonth         String
  grossSalary         Float
  netSalary           Float
  lohnsteuer          Float?
  kvBeitragAN         Float?
  rvBeitragAN         Float?
  avBeitragAN         Float?
  pvBeitragAN         Float?
  kvBeitragAG         Float?
  rvBeitragAG         Float?
  avBeitragAG         Float?
  pvBeitragAG         Float?
  umlage1             Float?
  umlage2             Float?
  umlagInsolv         Float?
  auszahlungsbetrag   Float
  rawData             String?
  uploadedFileId      String?
  uploadedFile        UploadedFile? @relation(fields: [uploadedFileId], references: [id])
  createdAt           DateTime @default(now())

  @@unique([companyId, employeeId, salaryMonth])
}

model BankTransaction {
  id                    String   @id @default(uuid())
  company               Company  @relation(fields: [companyId], references: [id])
  companyId             String
  accountIban           String
  bookingDate           DateTime
  valueDate             DateTime?
  bookingText           String?
  purpose               String?
  counterpartyName      String?
  counterpartyIban      String?
  bic                   String?
  amount                Float
  currency              String   @default("EUR")
  referenceId           String?
  inferredMonth         String?
  rawData               String?
  uploadedFileId        String?
  uploadedFile          UploadedFile? @relation(fields: [uploadedFileId], references: [id])
  createdAt             DateTime @default(now())
}

model ReconciliationRecord {
  id                    String   @id @default(uuid())
  companyId             String
  salaryMonth           String
  employee              Employee @relation(fields: [employeeId], references: [id])
  employeeId            String
  employeeName          String
  expectedAmount        Float
  paidAmount            Float    @default(0)
  status                String   @default("NEEDS_REVIEW")
  confidence            Int      @default(0)
  matchedTransactionId  String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, salaryMonth, employeeId])
}

model UploadedFile {
  id              String    @id @default(uuid())
  company         Company?  @relation(fields: [companyId], references: [id])
  companyId       String?
  originalName    String
  filePath        String?
  fileHash        String    @unique
  fileType        String
  detectedSchema  String?
  columnMappings  String?
  rowCount        Int       @default(0)
  status          String    @default("PENDING")
  errorMessage    String?
  uploadedAt      DateTime  @default(now())
  processedAt     DateTime?

  payrollRecords    PayrollRecord[]
  bankTransactions  BankTransaction[]
}
